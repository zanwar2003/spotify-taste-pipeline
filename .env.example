# Copy to .env and fill in. Never commit .env.

# Spotify developer app (https://developer.spotify.com/dashboard)
# Redirect URI must be registered exactly as below (Spotify no longer accepts "localhost").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Postgres (matches docker-compose.yml)
# DATABASE_URL: owner role, used by the Python pipeline (bronze writes, migrations).
# APP_DATABASE_URL: restricted role for the web app. Must not be a superuser, or
# row-level security is silently bypassed.
DATABASE_URL=postgresql://tastepipe:tastepipe@localhost:5432/tastepipe
APP_DATABASE_URL=postgresql://tastepipe_app:tastepipe_app@localhost:5432/tastepipe

# Web app secrets: generate each with `openssl rand -hex 32`
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Playlist agent (Python service, bound to 127.0.0.1). The web server calls it with a shared secret.
# Generate AGENT_INTERNAL_TOKEN with `openssl rand -hex 32`.
AGENT_URL=http://127.0.0.1:8000
AGENT_INTERNAL_TOKEN=
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
